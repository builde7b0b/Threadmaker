# OpenAI Configuration
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Twitter API Configuration (for Twitter integration)
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here
TWITTER_REDIRECT_URI=http://localhost:3000/api/twitter/callback

# Twitter Client-Side Configuration (for OAuth URL generation)
NEXT_PUBLIC_TWITTER_CLIENT_ID=your_twitter_client_id_here
NEXT_PUBLIC_TWITTER_REDIRECT_URI=http://localhost:3000/api/twitter/callback

# NextAuth Configuration (for OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Supabase Configuration (for payment system - optional)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe Configuration (for payments - optional)
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID=price_your_monthly_subscription_id_here
